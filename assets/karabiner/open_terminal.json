{
  "title": "Open Terminal with Cmd+Opt+T",
  "rules": [
    {
      "description": "Open Terminal",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "t",
            "modifiers": {
              "mandatory": ["command", "option"]
            }
          },
          "to": [
            {
              "shell_command": "open -a Terminal"
            }
          ]
        }
      ]
    }
  ]
}
